{
  "name": "dexbrowse-desktop",
  "productName": "DexBrowse",
  "version": "2.13.0",
  "description": "DexBrowse By Fuad - Chromium desktop browser",
  "main": "main.js",
  "author": "Fuad",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/write-config.js && electron .",
    "dist": "node scripts/write-config.js && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.fuad.dexbrowse.desktop",
    "productName": "DexBrowse",
    "files": [
      "main.js",
      "preload.js",
      "sync.js",
      "config.js",
      "uas.js",
      "app-config.json",
      "ui/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DexBrowse-PC-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
