{
  "name": "dexbrowse-desktop",
  "productName": "DexBrowse",
  "version": "2.22.0",
  "description": "DexBrowse",
  "main": "main.js",
  "author": "Md. Fuad Hasan",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/write-config.js && electron .",
    "dist": "node scripts/write-config.js && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.fuad.dexbrowse.desktop",
    "productName": "DexBrowse",
    "files": [
      "main.js",
      "preload.js",
      "guest-preload.js",
      "sync.js",
      "shields.js",
      "shieldlists.js",
      "config.js",
      "uas.js",
      "app-config.json",
      "ui/**/*",
      "package.json",
      "extensions.js",
      "build/**",
      "profiles.js",
      "importer.js",
      "launcher-preload.js",
      "updater.js",
      "auth-preload.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DexBrowse-PC-Setup.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "DexBrowse",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "copyright": "Copyright \u00a9 Md. Fuad Hasan (DexBrowse By Fuad)",
    "publish": [
      {
        "provider": "github",
        "owner": "itsfuad41",
        "repo": "DexBrowse"
      }
    ]
  },
  "dependencies": {
    "sql.js": "^1.11.0",
    "electron-updater": "6.3.9"
  }
}